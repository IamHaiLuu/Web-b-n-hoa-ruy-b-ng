{
  "name": "menu-hoa",
  "version": "1.0.0",
  "description": "Website menu hoa server-rendered với Express, Pug, MongoDB, Tailwind và Cloudinary.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "build:css": "tailwindcss -i ./src/styles/tailwind.css -o ./public/css/app.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/tailwind.css -o ./public/css/app.css --watch",
    "seed:admin": "node scripts/seedAdmin.js",
    "seed:categories": "node scripts/seedCategories.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.5.1",
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "method-override": "^3.0.0",
    "mongoose": "^8.9.5",
    "multer": "^2.1.1",
    "pug": "^3.0.3",
    "sanitize-html": "^2.14.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "autoprefixer": "^10.4.20",
    "nodemon": "^3.1.9",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}
