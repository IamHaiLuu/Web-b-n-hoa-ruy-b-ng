- const values = old && Object.keys(old).length ? old : (flower || {});
- const selectedCategory = values.category && values.category._id ? values.category._id : values.category;
- const arrayText = (value) => Array.isArray(value) ? value.join(', ') : (value || '');

form(method="POST" action=formAction enctype="multipart/form-data" class="grid gap-6 xl:grid-cols-[1fr_380px]")
  if method === 'PUT'
    input(type="hidden" name="_method" value="PUT")
  div(class="space-y-5")
    div(class="soft-card p-5")
      h2(class="font-display text-xl font-bold text-textMain") Thông tin chính
      div(class="mt-5 grid gap-5 md:grid-cols-2")
        div(class="md:col-span-2")
          label(for="name" class="label") Tên sản phẩm
          input#name(type="text" name="name" value=(values.name || '') class="field" maxlength="120" required)
          if errors.name
            p(class="help-error")= errors.name
        div
          label(for="category" class="label") Danh mục
          select#category(name="category" class="field" required)
            option(value="") Chọn danh mục
            each category in categories
              option(value=category._id selected=String(category._id) === String(selectedCategory || ''))= category.name
          if errors.category
            p(class="help-error")= errors.category
        div
          label(for="referencePrice" class="label") Giá tham khảo
          input#referencePrice(type="number" name="referencePrice" value=(values.referencePrice || '') class="field" min="0" step="1000" required)
          if errors.referencePrice
            p(class="help-error")= errors.referencePrice
        div(class="md:col-span-2")
          label(for="shortDescription" class="label") Mô tả ngắn
          textarea#shortDescription(name="shortDescription" rows="3" maxlength="160" class="field")= values.shortDescription || ''
          if errors.shortDescription
            p(class="help-error")= errors.shortDescription
        div(class="md:col-span-2")
          label(for="description" class="label") Mô tả chi tiết
          textarea#description(name="description" rows="7" class="field")= values.description || ''
        div
          label(for="suitableOccasions" class="label") Dịp phù hợp
          input#suitableOccasions(type="text" name="suitableOccasions" value=arrayText(values.suitableOccasions) placeholder="Sinh nhật, kỷ niệm..." class="field")
        div
          label(for="mainColors" class="label") Màu sắc chủ đạo
          input#mainColors(type="text" name="mainColors" value=arrayText(values.mainColors) placeholder="Hồng, kem, trắng..." class="field")
        div
          label(for="sizeNote" class="label") Kích thước tham khảo
          input#sizeNote(type="text" name="sizeNote" value=(values.sizeNote || '') class="field")
        div
          label(for="tags" class="label") Tags
          input#tags(type="text" name="tags" value=arrayText(values.tags) placeholder="Pastel, sinh nhật..." class="field")
        div(class="md:col-span-2")
          label(for="internalNote" class="label") Ghi chú nội bộ
          textarea#internalNote(name="internalNote" rows="3" class="field")= values.internalNote || ''

  aside(class="space-y-5")
    div(class="soft-card p-5")
      h2(class="font-display text-xl font-bold text-textMain") Trạng thái
      div(class="mt-5 space-y-4")
        div
          label(for="availabilityStatus" class="label") Tình trạng mẫu
          select#availabilityStatus(name="availabilityStatus" class="field")
            option(value="available" selected=(values.availabilityStatus || 'available') === 'available') Còn mẫu
            option(value="out_of_stock" selected=values.availabilityStatus === 'out_of_stock') Tạm hết
        div
          label(for="visibilityStatus" class="label") Hiển thị trên menu
          select#visibilityStatus(name="visibilityStatus" class="field")
            option(value="visible" selected=(values.visibilityStatus || 'visible') === 'visible') Đang hiển thị
            option(value="hidden" selected=values.visibilityStatus === 'hidden') Đang ẩn
        label(class="flex items-center justify-between rounded-2xl bg-cream-100 px-4 py-3 text-sm font-semibold text-textMain")
          span Đánh dấu nổi bật
          input(type="checkbox" name="isFeatured" checked=(values.isFeatured === true || values.isFeatured === 'on') class="rounded border-borderSoft text-rosePastel-300 focus:ring-rosePastel-200")

    div(class="soft-card p-5")
      h2(class="font-display text-xl font-bold text-textMain") Ảnh sản phẩm
      p(class="mt-2 text-sm leading-6 text-textSoft") Upload ảnh JPG, PNG, WEBP hoặc GIF. Cloudinary cần được cấu hình để lưu ảnh.
      if errors.images
        p(class="help-error")= errors.images
      if flower && flower.images && flower.images.length
        div(class="mt-4 grid grid-cols-2 gap-3")
          each image in flower.images
            div(class="rounded-2xl border border-borderSoft bg-white p-2")
              img(src=image.url alt=(image.alt || flower.name) class="aspect-square w-full rounded-xl object-cover")
              label(class="mt-2 flex items-center gap-2 text-xs font-semibold text-textSoft")
                input(type="radio" name="primaryImageId" value=image._id checked=image.isPrimary class="border-borderSoft text-rosePastel-300 focus:ring-rosePastel-200")
                | Ảnh chính
              label(class="mt-2 flex items-center gap-2 text-xs font-semibold text-red-600")
                input(type="checkbox" name="deleteImageIds" value=image._id class="rounded border-borderSoft text-red-500 focus:ring-red-200")
                | Xóa ảnh này
      label(for="images" class="label mt-5") Thêm ảnh mới
      input#images(type="file" name="images" multiple accept="image/jpeg,image/png,image/webp,image/gif" data-image-input="#image-preview" class="field file:mr-4 file:rounded-full file:border-0 file:bg-rosePastel-100 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-primary")
      div#image-preview(class="mt-4 grid grid-cols-3 gap-3")

    div(class="flex flex-col gap-3")
      button(type="submit" class="btn-primary w-full")
        span(class="material-symbols-outlined") save
        = submitLabel
      a(href="/admin/flowers" class="btn-secondary w-full") Hủy
