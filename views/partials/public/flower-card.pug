mixin flowerCard(flower)
  article(class="soft-card group flex h-full flex-col overflow-hidden p-3")
    a(href=`/flowers/${flower.slug}` class="block overflow-hidden rounded-2xl bg-cream-200")
      img(src=getPrimaryImageUrl(flower) alt=flower.name class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-105")
    div(class="flex flex-1 flex-col p-3")
      div(class="mb-3 flex flex-wrap items-center gap-2")
        if flower.category
          span(class="rounded-full bg-lavender-100 px-3 py-1 text-xs font-semibold text-primary")= flower.category.name
        if flower.availabilityStatus === 'available'
          span(class="rounded-full bg-mint-100 px-3 py-1 text-xs font-semibold text-emerald-700") Còn mẫu
        else
          span(class="rounded-full bg-cream-200 px-3 py-1 text-xs font-semibold text-textSoft") Tạm hết
        if flower.isFeatured
          span(class="rounded-full bg-rosePastel-100 px-3 py-1 text-xs font-semibold text-primary") Nổi bật
      h3(class="font-display text-lg font-semibold text-textMain")
        a(href=`/flowers/${flower.slug}` class="hover:text-primary")= flower.name
      p(class="mt-2 line-clamp-2 text-sm leading-6 text-textSoft")= flower.shortDescription || 'Mẫu hoa đang được cập nhật mô tả.'
      if flower.tags && flower.tags.length
        div(class="mt-3 flex flex-wrap gap-2")
          each tag in flower.tags.slice(0, 3)
            span(class="rounded-full bg-cream-100 px-3 py-1 text-xs font-medium text-textSoft")= tag
      div(class="mt-auto flex items-center justify-between gap-3 pt-5")
        p(class="font-display text-lg font-bold text-textMain")= formatCurrency(flower.referencePrice)
        a(href=`/flowers/${flower.slug}` class="btn-secondary !px-4 !py-2")
          | Xem chi tiết
          span(class="material-symbols-outlined") arrow_forward
