    div(class="mx-auto max-w-3xl text-center")
      p(class="text-xs font-bold uppercase tracking-wide text-primary") Liên hệ cửa hàng
      h1(class="mt-3 font-display text-4xl font-bold text-textMain") #{settings && settings.storeName ? settings.storeName : 'Menu Hoa'}
