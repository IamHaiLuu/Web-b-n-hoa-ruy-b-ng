extends ../layouts/public

include ../partials/public/flower-card

block content
  - const galleryImages = flower.images && flower.images.length ? [...flower.images].sort((a, b) => (a.sortOrder || 0) - (b.sortOrder || 0)) : [{ url: '/images/placeholders/flower-placeholder.svg', alt: flower.name }];
  - const primaryImage = galleryImages.find((image) => image.isPrimary) || galleryImages[0];

  section(class="shell py-10 lg:py-14")
    a(href="/" class="mb-6 inline-flex items-center gap-2 text-sm font-semibold text-textSoft hover:text-textMain")
      span(class="material-symbols-outlined") arrow_back
      | Quay lại menu
    div(class="grid gap-8 lg:grid-cols-[1.05fr_0.95fr]")
      div(data-gallery class="space-y-4")
        div(class="overflow-hidden rounded-4xl border border-borderSoft bg-white p-3 shadow-soft")
          img(data-gallery-main src=primaryImage.url alt=(primaryImage.alt || flower.name) class="aspect-square w-full rounded-3xl object-cover")
        if galleryImages.length > 1
          div(class="flex gap-3 overflow-x-auto pb-2")
            each image, index in galleryImages
              button(type="button" data-gallery-thumb data-image-url=image.url data-image-alt=(image.alt || flower.name) aria-pressed=(image.url === primaryImage.url ? 'true' : 'false') class="shrink-0 overflow-hidden rounded-2xl border-2 border-borderSoft bg-white p-1 aria-pressed:border-rosePastel-200")
                img(src=image.url alt=(image.alt || `${flower.name} ${index + 1}`) class="h-20 w-20 rounded-xl object-cover")

      aside(class="soft-card p-6 lg:p-8")
        div(class="flex flex-wrap gap-2")
          if flower.category
            span(class="rounded-full bg-lavender-100 px-3 py-1 text-xs font-semibold text-primary")= flower.category.name
          if flower.availabilityStatus === 'available'
            span(class="rounded-full bg-mint-100 px-3 py-1 text-xs font-semibold text-emerald-700") Còn mẫu
          else
            span(class="rounded-full bg-cream-200 px-3 py-1 text-xs font-semibold text-textSoft") Tạm hết
          if flower.isFeatured
            span(class="rounded-full bg-rosePastel-100 px-3 py-1 text-xs font-semibold text-primary") Nổi bật
        h1(class="mt-4 font-display text-3xl font-bold leading-tight text-textMain sm:text-4xl")= flower.name
        p(class="mt-4 font-display text-2xl font-bold text-primary")= formatCurrency(flower.referencePrice)
        p(class="mt-4 text-sm leading-7 text-textSoft")= flower.shortDescription || 'Mẫu hoa đang được cập nhật mô tả chi tiết.'
        if flower.description
          div(class="prose prose-sm mt-5 max-w-none text-textSoft")
            != flower.description
        dl(class="mt-6 grid gap-4 text-sm")
          if flower.suitableOccasions && flower.suitableOccasions.length
            div
              dt(class="font-semibold text-textMain") Phù hợp cho dịp
              dd(class="mt-2 flex flex-wrap gap-2")
                each item in flower.suitableOccasions
                  span(class="rounded-full bg-cream-100 px-3 py-1 text-textSoft")= item
          if flower.mainColors && flower.mainColors.length
            div
              dt(class="font-semibold text-textMain") Màu sắc chủ đạo
              dd(class="mt-2 flex flex-wrap gap-2")
                each item in flower.mainColors
                  span(class="rounded-full bg-cream-100 px-3 py-1 text-textSoft")= item
          if flower.sizeNote
            div
              dt(class="font-semibold text-textMain") Kích thước tham khảo
              dd(class="mt-1 text-textSoft")= flower.sizeNote
          if flower.tags && flower.tags.length
            div
              dt(class="font-semibold text-textMain") Tags
              dd(class="mt-2 flex flex-wrap gap-2")
                each tag in flower.tags
                  span(class="rounded-full bg-rosePastel-100 px-3 py-1 text-primary")= tag
        div(class="mt-8 flex flex-wrap gap-3")
          a(href=getZaloUrl(settings && settings.zalo) target="_blank" rel="noopener" class="btn-primary")
            span(class="material-symbols-outlined") chat
            | Nhắn Zalo để tư vấn
          a(href=phoneUrl(settings && settings.phone) class="btn-secondary")
            span(class="material-symbols-outlined") call
            | Gọi cửa hàng
          a(href="/" class="btn-secondary")
            span(class="material-symbols-outlined") arrow_back
            | Quay lại menu

  if relatedFlowers && relatedFlowers.length
    section(class="shell pb-12")
      div(class="mb-6")
        p(class="text-xs font-bold uppercase tracking-wide text-primary") Gợi ý
        h2(class="font-display text-3xl font-semibold text-textMain") Có thể bạn cũng thích
      div(class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4")
        each related in relatedFlowers
          +flowerCard(related)

block scripts
  script(src="/js/public-gallery.js")
