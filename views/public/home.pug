extends ../layouts/public

include ../partials/public/flower-card

block content
  section(class="shell grid gap-10 py-10 lg:grid-cols-[1fr_0.9fr] lg:items-center lg:py-16")
    div
      p(class="inline-flex rounded-full bg-rosePastel-100 px-4 py-2 text-xs font-bold uppercase tracking-wide text-primary") Pastel Korean style
      h1(class="mt-5 max-w-3xl font-display text-4xl font-bold leading-tight text-textMain sm:text-5xl lg:text-6xl")
        | Menu hoa tươi
        br
        span(class="italic text-rosePastel-300") mỗi ngày
      p(class="mt-5 max-w-xl text-base leading-7 text-textSoft sm:text-lg") Khám phá các mẫu hoa tươi, bó hoa, giỏ hoa và set hoa theo dịp. Menu chỉ dùng để tham khảo, vui lòng liên hệ cửa hàng để được tư vấn.
      div(class="mt-7 flex flex-wrap gap-3")
        a(href="#menu" class="btn-primary")
          span(class="material-symbols-outlined") local_florist
          | Xem menu hoa
        a(href=getZaloUrl(settings && settings.zalo) class="btn-secondary" target="_blank" rel="noopener")
          span(class="material-symbols-outlined") chat
          | Liên hệ Zalo
    div(class="relative")
      div(class="absolute inset-6 rounded-full bg-rosePastel-100 blur-3xl")
      div(class="relative overflow-hidden rounded-4xl border border-borderSoft bg-white p-3 shadow-soft")
        img(src=(settings && settings.banner && settings.banner.url ? settings.banner.url : '/images/placeholders/flower-placeholder.svg') alt="Hoa tươi pastel" class="aspect-[4/3] w-full rounded-3xl object-cover")
        div(class="mt-3 grid grid-cols-3 gap-3 text-center text-xs font-semibold text-textSoft")
          span(class="rounded-2xl bg-cream-100 px-3 py-2") Hoa mới
          span(class="rounded-2xl bg-lavender-100 px-3 py-2") Pastel
          span(class="rounded-2xl bg-mint-100 px-3 py-2") Tư vấn

  include ../partials/public/category-filter

  section#menu(class="shell py-8")
    div(class="mb-6 flex flex-col justify-between gap-4 lg:flex-row lg:items-end")
      div
        p(class="text-xs font-bold uppercase tracking-wide text-primary") Menu hoa
        h2(class="font-display text-3xl font-semibold text-textMain") Các mẫu hoa đang hiển thị
      form(method="GET" action="/" class="grid gap-3 rounded-3xl border border-borderSoft bg-white p-3 shadow-card sm:grid-cols-2 lg:grid-cols-[260px_180px_180px_120px]")
        input(type="text" name="q" value=(query.q || '') placeholder="Tìm tên hoa, màu sắc..." class="field rounded-2xl")
        select(name="price" class="field rounded-2xl")
          option(value="") Khoảng giá
          option(value="under-300" selected=query.price === 'under-300') Dưới 300.000đ
          option(value="300-500" selected=query.price === '300-500') 300.000đ - 500.000đ
          option(value="500-1000" selected=query.price === '500-1000') 500.000đ - 1.000.000đ
          option(value="over-1000" selected=query.price === 'over-1000') Trên 1.000.000đ
        select(name="status" class="field rounded-2xl")
          option(value="") Trạng thái
          option(value="available" selected=query.status === 'available') Còn mẫu
          option(value="out_of_stock" selected=query.status === 'out_of_stock') Tạm hết
        if query.category
          input(type="hidden" name="category" value=query.category)
        button(type="submit" class="btn-primary !py-2")
          span(class="material-symbols-outlined") search
          | Lọc
    if query.q || query.price || query.status || query.category
      div(class="mb-5")
        a(href="/" class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:text-textMain")
          span(class="material-symbols-outlined") close
          | Xóa lọc

    if flowers && flowers.length
      div(class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4")
        each flower in flowers
          +flowerCard(flower)
      include ../partials/public/pagination
    else
      div(class="soft-card mx-auto max-w-2xl p-10 text-center")
        img(src="/images/placeholders/flower-placeholder.svg" alt="Chưa có mẫu hoa" class="mx-auto h-40 w-40 rounded-3xl object-cover")
        h3(class="mt-5 font-display text-2xl font-semibold text-textMain") Chưa có mẫu hoa phù hợp
        p(class="mt-3 text-sm leading-6 text-textSoft") Cửa hàng đang cập nhật menu hoặc bộ lọc hiện tại chưa có kết quả. Hãy thử xóa lọc hoặc liên hệ cửa hàng để được tư vấn.
        a(href="/" class="btn-primary mt-5") Xem lại toàn bộ menu

  if featuredFlowers && featuredFlowers.length
    section#featured(class="shell py-12")
      div(class="mb-6")
        p(class="text-xs font-bold uppercase tracking-wide text-primary") Nổi bật
        h2(class="font-display text-3xl font-semibold text-textMain") Mẫu hoa được yêu thích
      div(class="grid gap-5 md:grid-cols-2 lg:grid-cols-3")
        each flower in featuredFlowers
          +flowerCard(flower)

  include ../partials/public/contact-cta
