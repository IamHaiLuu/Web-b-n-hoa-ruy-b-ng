extends ../layouts/public

block content
  section(class="shell py-20")
    div(class="soft-card mx-auto max-w-xl p-10 text-center")
      span(class="material-symbols-outlined mx-auto text-5xl text-rosePastel-300") search_off
      h1(class="mt-5 font-display text-3xl font-bold text-textMain") Không tìm thấy trang
      p(class="mt-3 text-sm leading-6 text-textSoft")= message || 'Trang bạn đang tìm không tồn tại.'
      a(href="/" class="btn-primary mt-6") Về trang chủ
